{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "devtools": true,
        "userAgent": null,
        "titleBarStyle": "Overlay",
        "create": false
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-voloz-uinput.rules": "linux/60-voloz-uinput.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/60-voloz-uinput.rules": "linux/60-voloz-uinput.rules"
        }
      }
    },
    "category": "Utility",
    "shortDescription": "Voice dictation: hold a shortcut, speak, and the text appears where you type.",
    "longDescription": "Voloz Lite turns your speech into clean text in any app. Hold the shortcut, speak, release: the text is transcribed and refined by the services you choose (your own Groq, OpenAI or Claude keys) and pasted where the cursor is."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mvoloch/voloz/releases/download/lite-latest/latest.json"
      ]
    }
  }
}
