{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "devtools": true,
        "userAgent": null,
        "titleBarStyle": "Overlay",
        "create": false
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-voloz-uinput.rules": "linux/60-voloz-uinput.rules"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mvoloch/voloz/releases/download/lite-latest/latest.json"
      ]
    }
  }
}
