    <string name="key_forget_body">The %1$s key is removed from this phone. To use %2$s with it again, you\'ll need to paste it again.</string>

    <!-- 3. Microphone -->
    <string name="mic_title">Let Voloz hear you</string>
    <string name="mic_body">The microphone only turns on when you tap the bubble. While recording, Android shows the green mic-in-use dot and a Voloz notification.</string>
    <string name="mic_preview_note">This is the notification you see during dictation. It goes away once the text is inserted.</string>
    <string name="mic_cta">Allow microphone</string>
    <string name="mic_skip">Already allowed, continue</string>

    <!-- 4. Accessibility -->
    <string name="a11y_title">Turn on Voloz in Accessibility</string>
    <string name="a11y_body">This lets Voloz show the bubble when you\'re in a text field and put the text where the cursor is, in any app.</string>
    <string name="a11y_step1"><![CDATA[Tap the button below. Under <b>Installed apps</b>, open <b>Voloz</b> and turn on the switch.]]></string>
    <string name="a11y_step2"><![CDATA[Seeing <b>Restricted setting</b>? Go to Settings › Apps › Voloz, tap <b>⋮</b> and then <b>Allow restricted settings</b>. Then repeat step 1.]]></string>
    <string name="a11y_open_app_info">Open Settings › Apps › Voloz</string>
    <string name="a11y_privacy">Voloz only checks which field is active. It doesn\'t read or store what\'s on screen.</string>
