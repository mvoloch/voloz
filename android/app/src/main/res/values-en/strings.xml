    <!-- 6. Settings (the desktop Lite sections) -->
    <string name="section_bubble">Bubble</string>
    <string name="section_bubble_lede">Where the bubble appears and how you record.</string>
    <string name="section_transcription">Transcription</string>
    <string name="section_transcription_lede">Who turns your voice into text. If the first one fails, Voloz moves on to the next on the list by itself.</string>
    <string name="section_refinement">Refinement</string>
    <string name="section_refinement_lede">Who cleans up the text before it\'s inserted: punctuation, filler words, changes of mind mid-sentence.</string>
    <string name="section_vocabulary">Vocabulary</string>
    <string name="section_vocabulary_lede">Names and terms transcription gets wrong, and short phrases that turn into saved text.</string>
