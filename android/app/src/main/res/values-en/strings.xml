    <string name="group_cleanup">What to clean up</string>
    <string name="refine_cleanup">Smart cleanup</string>
    <string name="refine_cleanup_sub">Remove filler words (um, uh, like), restore punctuation, and fix capitalization without rephrasing.</string>
    <string name="refine_self_correction">Remove self-corrections</string>
    <string name="refine_self_correction_sub">When you change your mind mid-sentence (“actually, no…”, “wait, I meant…”), drop the retracted part and keep the final intent.</string>
    <string name="refine_adapt">Adapt style to the app</string>
    <string name="refine_adapt_sub">Emails get full sentences and paragraphs, chat messages stay short and casual, code editors and terminals keep names exactly as spoken. Other apps are unchanged.</string>
    <string name="refine_technical">Preserve technical terms</string>
    <string name="refine_technical_sub">Keep code identifiers, command names, and acronyms exactly as spoken.</string>
    <string name="providers_hint">The first one is the main one. If it fails or hits its limit, the next on the list gets the same request. A provider that hit its limit is skipped until the wait it asked for is over.</string>
