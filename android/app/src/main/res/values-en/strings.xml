    <!-- 1. Welcome -->
    <string name="welcome_headline">Speak. The text appears where you\'re typing.</string>
    <string name="welcome_body">A small bubble sits at the edge of the screen. Tap it, speak, and the finished text goes into WhatsApp, Gmail or any field, with punctuation and spelling fixed.</string>
    <string name="welcome_cta">Get started</string>
    <string name="welcome_footnote">Uses your own Groq key. Your audio goes straight to Groq, without passing through Voloz servers.</string>

    <!-- 2. Key -->
    <string name="key_title">Paste your Groq key</string>
    <string name="key_body">It\'s what transcribes what you say. Creating one is free and takes a minute.</string>
    <string name="key_step1"><![CDATA[Go to <a href="https://console.groq.com/keys">console.groq.com/keys</a> and sign in with Google.]]></string>
    <string name="key_step2"><![CDATA[Tap <b>Create API Key</b>, give it a name and copy the key.]]></string>
    <string name="key_step3">Come back here and paste it below.</string>
    <string name="key_label">API key</string>
    <string name="key_placeholder">Paste the key here</string>
    <string name="key_test">Test</string>
    <string name="key_testing">Testing…</string>
    <string name="key_ok">Key works</string>
    <string name="key_save">Save</string>
    <string name="key_footnote">The key is stored encrypted, only on this phone.</string>
    <string name="key_test_save">Test and save</string>
    <string name="key_dialog_title">%1$s key</string>
    <string name="key_dialog_saved">Saved</string>
    <string name="key_dialog_paste">Paste the key</string>
    <string name="key_dialog_paste_other">Or paste another</string>
