    <string name="section_bubble">Bolha</string>
    <string name="section_bubble_lede">Onde a bolha aparece e como você grava.</string>
    <string name="section_transcription">Transcrição</string>
    <string name="section_transcription_lede">Quem transforma sua voz em texto. Se o primeiro falhar, o Voloz passa para o próximo da lista sozinho.</string>
    <string name="section_refinement">Refinamento</string>
    <string name="section_refinement_lede">Quem limpa o texto antes de inserir: pontuação, hesitações, mudanças de ideia no meio da frase.</string>
    <string name="section_vocabulary">Vocabulário</string>
    <string name="section_vocabulary_lede">Nomes e termos que a transcrição erra, e frases curtas que viram textos prontos.</string>
