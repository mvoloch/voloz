    <string name="gesture_hold">Segure</string>
    <string name="gesture_hold_body">Fale enquanto segura; ao soltar, o texto entra.</string>
    <string name="gesture_double">Dois toques: comando de voz</string>
    <string name="gesture_double_body">Com texto selecionado, diga o que fazer com ele (“deixa mais formal”, “traduz para o inglês”) e o resultado substitui a seleção. Sem seleção, o Voloz escreve o que você pedir (“responde dizendo que eu aceito”). Toque de novo para terminar.</string>
    <string name="settings_refine">Refinar automaticamente</string>
