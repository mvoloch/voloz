<!-- Default locale is pt-BR for now (design copy). Strings with markup use CDATA and are rendered with AnnotatedString.fromHtml. -->
<resources>
    <string name="app_name" translatable="false">Voloz</string>
    <string name="a11y_description">Mostra a bolha de ditado quando um campo de texto está ativo e coloca o texto ditado onde está o cursor. O Voloz só olha qual campo está ativo. Não lê nem guarda o que aparece na tela.</string>

    <!-- Common -->
    <string name="common_continue">Continuar</string>
    <string name="common_add">Adicionar</string>
    <string name="common_cancel">Cancelar</string>
    <string name="cd_back">Voltar</string>
    <string name="cd_settings">Ajustes</string>
    <string name="cd_copy">Copiar</string>

    <!-- Recording notification -->
    <string name="notif_channel_name">Ditado</string>
    <string name="notif_recording_title">Voloz está gravando</string>
    <string name="notif_recording_text">Toque na bolha para terminar</string>
    <string name="notif_action_finish">Terminar</string>

    <!-- Bubble (symbols only on screen; these are for TalkBack) -->
    <string name="bubble_cd_idle">Ditado do Voloz. Toque para falar, ou segure enquanto fala.</string>
    <string name="bubble_cd_recording">Gravando. Toque para terminar.</string>
    <string name="bubble_cd_processing">Transcrevendo</string>
    <string name="bubble_cd_done">Texto inserido</string>
