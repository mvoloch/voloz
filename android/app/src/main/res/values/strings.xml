    <!-- 1. Boas-vindas -->
    <string name="welcome_headline">Fale. O texto aparece onde você está digitando.</string>
    <string name="welcome_body">Uma bolha pequena fica na borda da tela. Toque nela, fale, e o texto entra pronto no WhatsApp, no Gmail ou em qualquer campo, com pontuação e ortografia corrigidas.</string>
    <string name="welcome_cta">Começar</string>
    <string name="welcome_footnote">Usa a sua própria chave da Groq. Seu áudio vai direto para a Groq, sem passar por servidores do Voloz.</string>

    <!-- 2. Chave -->
    <string name="key_title">Cole a sua chave da Groq</string>
    <string name="key_body">É ela que transcreve o que você fala. Criar uma é grátis e leva um minuto.</string>
    <string name="key_step1"><![CDATA[Entre em <a href="https://console.groq.com/keys">console.groq.com/keys</a> com o seu Google.]]></string>
    <string name="key_step2"><![CDATA[Toque em <b>Create API Key</b>, dê um nome e copie a chave.]]></string>
    <string name="key_step3">Volte aqui e cole abaixo.</string>
    <string name="key_label">Chave da API</string>
    <string name="key_placeholder">Cole a chave aqui</string>
    <string name="key_test">Testar</string>
    <string name="key_testing">Testando…</string>
    <string name="key_ok">Chave funcionando</string>
    <string name="key_save">Salvar</string>
    <string name="key_footnote">A chave fica guardada criptografada, só neste celular.</string>
    <string name="key_test_save">Testar e salvar</string>
    <string name="key_dialog_title">Chave da %1$s</string>
    <string name="key_dialog_saved">Guardadas</string>
    <string name="key_dialog_paste">Cole a chave</string>
