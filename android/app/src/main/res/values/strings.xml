    <string name="key_forget_body">A chave %1$s sai deste celular. Para usar %2$s com ela de novo, será preciso colá-la outra vez.</string>

    <!-- 3. Microfone -->
    <string name="mic_title">Deixe o Voloz ouvir você</string>
    <string name="mic_body">O microfone só liga quando você toca na bolha. Enquanto grava, o Android mostra o ponto verde de microfone em uso e uma notificação do Voloz.</string>
    <string name="mic_preview_note">É essa notificação que aparece durante o ditado. Ela some quando o texto é inserido.</string>
    <string name="mic_cta">Permitir microfone</string>
    <string name="mic_skip">Já permiti, continuar</string>

    <!-- 4. Acessibilidade -->
    <string name="a11y_title">Ative o Voloz em Acessibilidade</string>
    <string name="a11y_body">É o que deixa o Voloz mostrar a bolha quando você está num campo de texto e colocar o texto onde está o cursor, em qualquer app.</string>
    <string name="a11y_step1"><![CDATA[Toque no botão abaixo. Em <b>Apps instalados</b>, abra <b>Voloz</b> e ligue a chave.]]></string>
    <string name="a11y_step2"><![CDATA[Apareceu <b>Configuração restrita</b>? Vá em Configurações › Apps › Voloz, toque em <b>⋮</b> e em <b>Permitir configurações restritas</b>. Depois repita o passo 1.]]></string>
    <string name="a11y_open_app_info">Abrir Configurações › Apps › Voloz</string>
    <string name="a11y_privacy">O Voloz só olha qual campo está ativo. Não lê nem guarda o que aparece na tela.</string>
