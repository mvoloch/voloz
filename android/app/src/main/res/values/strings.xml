    <string name="tooltip_hands_free" translatable="false">Hands Free</string>
    <string name="tooltip_tap_again">toque de novo para terminar</string>

    <!-- Dictation messages (toasts) -->
    <string name="msg_need_key">Coloque a sua chave da Groq no app Voloz.</string>
    <string name="msg_need_mic">Permita o microfone no app Voloz.</string>
    <string name="msg_too_short">Curto demais. Fale um pouco mais.</string>
    <string name="msg_mic_unavailable">Não deu para abrir o microfone.</string>
    <string name="msg_mic_silent">O microfone só entregou silêncio. O Android pode ter bloqueado a gravação.</string>
    <string name="msg_nothing_heard">Nada foi ouvido.</string>
    <!-- History line for a failed take: seconds, loudest volume %, what Groq returned. -->
    <string name="diag_nothing_heard">Nada foi ouvido · %1$s s de áudio · volume máximo %2$d%% · a Groq devolveu: %3$s</string>
