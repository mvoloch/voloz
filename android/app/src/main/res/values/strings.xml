    <string name="msg_insert_failed">Não deu para inserir aqui. O texto ficou copiado: toque na bolha para colar.</string>
    <string name="msg_paste_failed">Não deu para colar. O texto continua copiado.</string>
    <string name="msg_refine_failed">A correção falhou; entrou o texto sem correção.</string>
    <string name="msg_key_invalid">Chave da Groq inválida.</string>
    <string name="msg_rate_limit">Limite da Groq atingido. Tente de novo em instantes.</string>
    <string name="msg_too_large">Gravação grande demais para a Groq.</string>
    <string name="msg_network">Sem conexão com a Groq.</string>
    <string name="msg_groq_http">Erro da Groq (%1$d).</string>
    <string name="msg_unexpected">Erro inesperado (%1$s).</string>
    <string name="msg_copied">Copiado</string>

    <!-- 1. Boas-vindas -->
    <string name="welcome_headline">Fale. O texto aparece onde você está digitando.</string>
    <string name="welcome_body">Uma bolha pequena fica na borda da tela. Toque nela, fale, e o texto entra pronto no WhatsApp, no Gmail ou em qualquer campo, com pontuação e ortografia corrigidas.</string>
    <string name="welcome_cta">Começar</string>
    <string name="welcome_footnote">Usa a sua própria chave da Groq. Seu áudio vai direto para a Groq, sem passar por servidores do Voloz.</string>

    <!-- 2. Chave -->
    <string name="key_title">Cole a sua chave da Groq</string>
    <string name="key_body">É ela que transcreve o que você fala. Criar uma é grátis e leva um minuto.</string>
    <string name="key_step1"><![CDATA[Entre em <a href="https://console.groq.com/keys">console.groq.com/keys</a> com o seu Google.]]></string>
    <string name="key_step2"><![CDATA[Toque em <b>Create API Key</b>, dê um nome e copie a chave.]]></string>
    <string name="key_step3">Volte aqui e cole abaixo.</string>
    <string name="key_label">Chave da API</string>
    <string name="key_placeholder">Cole a chave aqui</string>
    <string name="key_test">Testar</string>
    <string name="key_testing">Testando…</string>
    <string name="key_ok">Chave funcionando</string>
    <string name="key_save">Salvar</string>
    <string name="key_footnote">A chave fica guardada criptografada, só neste celular.</string>

    <!-- 3. Microfone -->
    <string name="mic_title">Deixe o Voloz ouvir você</string>
    <string name="mic_body">O microfone só liga quando você toca na bolha. Enquanto grava, o Android mostra o ponto verde de microfone em uso e uma notificação do Voloz.</string>
    <string name="mic_preview_note">É essa notificação que aparece durante o ditado. Ela some quando o texto é inserido.</string>
    <string name="mic_cta">Permitir microfone</string>
    <string name="mic_skip">Já permiti, continuar</string>

    <!-- 4. Acessibilidade -->
    <string name="a11y_title">Ative o Voloz em Acessibilidade</string>
    <string name="a11y_body">É o que deixa o Voloz mostrar a bolha quando você está num campo de texto e colocar o texto onde está o cursor, em qualquer app.</string>
    <string name="a11y_step1"><![CDATA[Toque no botão abaixo. Em <b>Apps instalados</b>, abra <b>Voloz</b> e ligue a chave.]]></string>
    <string name="a11y_step2"><![CDATA[Apareceu <b>Configuração restrita</b>? Vá em Configurações › Apps › Voloz, toque em <b>⋮</b> e em <b>Permitir configurações restritas</b>. Depois repita o passo 1.]]></string>
    <string name="a11y_open_app_info">Abrir Configurações › Apps › Voloz</string>
    <string name="a11y_privacy">O Voloz só olha qual campo está ativo. Não lê nem guarda o que aparece na tela.</string>
    <string name="a11y_status_off">Ainda não ativado</string>
    <string name="a11y_status_on">Ativado</string>
