<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone (Android 12+): the saved keys are Keystore-encrypted and
     can't be restored elsewhere anyway. Pairs with allowBackup="false" for older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
